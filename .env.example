# 複製此檔為 .env 並填入你「重發後」的新金鑰。.env 不要 commit。
LINE_CHANNEL_SECRET=你的_LINE_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=你的_LINE_channel_access_token
ANTHROPIC_API_KEY=sk-ant-api03-xxxx
RAGIC_API_KEY=你的_Ragic_API_key_base64

# ---- 階段 3:Ragic 寫入設定(從表單網址取得)----
# 表單網址長相:https://{RAGIC_SERVER}/{RAGIC_ACCOUNT}/{頁籤路徑}/{表單編號}
# 例如 https://ap7.ragic.com/yangoo/forms8/3 → SERVER=ap7.ragic.com, ACCOUNT=yangoo, SHEET=forms8/3
RAGIC_SERVER=ap7.ragic.com
RAGIC_ACCOUNT=你的帳號
RAGIC_SHEET=頁籤路徑/表單編號
